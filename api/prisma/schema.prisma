generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/patterns.db"
}

model Pattern {
  id        String   @id @default(uuid())
  name      String
  width     Int
  height    Int
  liveCells String   // JSON-encoded [number, number][]
  createdAt DateTime @default(now())
}
