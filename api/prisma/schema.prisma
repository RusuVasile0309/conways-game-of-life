generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pattern {
  id        String   @id @default(uuid())
  name      String
  width     Int
  height    Int
  liveCells String   // JSON-encoded [number, number][]
  createdAt DateTime @default(now())
}
