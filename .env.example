# Copy this file to .env and fill in the values.
# .env is gitignored — never commit real credentials.

# PostgreSQL connection string (required for save/load pattern feature).
# Provision a free database at https://neon.tech, then paste the connection URL here.
# After setting this, run: api/node_modules/.bin/prisma migrate deploy --schema=api/prisma/schema.prisma
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optional: override the API base URL the Next.js frontend calls.
# Defaults to /api (Next.js route handlers) when unset.
# Set this if you run the NestJS API separately (e.g. http://localhost:3333).
# NEXT_PUBLIC_API_BASE_URL=
